# =============================================================================
# LOCAL COMMERCE AI VOICE AGENT — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to backend/.env.local and frontend/.env.local as required.
# NEVER commit real API keys or secrets to public repositories.

# LiveKit WebRTC & SIP Credentials
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Speech & Voice AI Services
MURF_API_KEY=your_murf_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Agent Configuration
AGENT_NAME=my-agent

# Optional Day 6 Outbound Telephony (LiveKit SIP + Linphone)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_trunk_id_here
LINPHONE_USERNAME=your_linphone_username_here
LINPHONE_SIP_ADDRESS=sip:your_linphone_username_here@sip.linphone.org
MAX_RETRIES=2

# Optional Testing & Simulation Flags
SIMULATE_CATALOGUE_FAILURE=false
